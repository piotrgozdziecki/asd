{
  "entities": {
    "Project": {
      "title": "Wedding Project",
      "description": "Stan projektu wideo i timeline",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "state": { "type": "object" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "state", "updatedAt"]
    },
    "SavedStory": {
      "title": "Saved Story",
      "description": "Zapisany scenariusz weselny lub notatka reżyserska",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "concept": { "type": "string", "maxLength": 5000 },
        "musicSuggestion": { "type": "string", "maxLength": 500 },
        "voiceover": { "type": "string", "maxLength": 5000 },
        "timeline": { "type": "array" },
        "mediaItems": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "createdAt", "updatedAt"]
    },
    "ProjectTemplate": {
      "title": "Project Template",
      "description": "Szablon i struktura projektu do wielokrotnego użycia",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "description": { "type": "string", "maxLength": 2000 },
        "category": { "type": "string", "maxLength": 128 },
        "icon": { "type": "string", "maxLength": 64 },
        "isPrebuilt": { "type": "boolean" },
        "structure": { "type": "object" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "structure", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Zapisane projekty weselne użytkownika"
    },
    "/users/{userId}/stories/{storyId}": {
      "schema": { "$ref": "#/entities/SavedStory" },
      "description": "Zapisane historie i scenariusze użytkownika"
    },
    "/users/{userId}/templates/{templateId}": {
      "schema": { "$ref": "#/entities/ProjectTemplate" },
      "description": "Szablony struktur projektów zapisane przez użytkownika"
    }
  }
}
