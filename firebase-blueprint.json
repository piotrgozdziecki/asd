{
  "entities": {
    "Project": {
      "title": "Wedding Project",
      "description": "Stan projektu wideo i timeline",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "state": { "type": "object" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "state", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Zapisane projekty weselne użytkownika"
    }
  }
}
