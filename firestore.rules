rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidProject(data) {
      return data.keys().hasAll(['userId', 'state', 'updatedAt'])
        && data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid
        && data.state is map;
    }

    match /users/{userId}/projects/{projectId} {
      allow get, list: if isSignedIn() && request.auth.uid == userId;
      
      allow create: if isSignedIn() 
        && request.auth.uid == userId 
        && isValidId(projectId)
        && isValidProject(incoming());

      allow update: if isSignedIn() 
        && request.auth.uid == userId 
        && isValidId(projectId)
        && incoming().userId == existing().userId
        && isValidProject(incoming());

      allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(projectId);
    }
  }
}
