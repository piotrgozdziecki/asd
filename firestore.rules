rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Healthcheck / Connection test endpoint
    match /test/connection {
      allow get: if true;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidProject(data) {
      return data.keys().hasAll(['userId', 'state', 'updatedAt'])
        && data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid
        && data.state is map;
    }

    function isValidStory(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid
        && data.title is string && data.title.size() <= 256
        && data.createdAt is string
        && data.updatedAt is string;
    }

    match /users/{userId}/projects/{projectId} {
      allow get, list: if isSignedIn() && request.auth.uid == userId;
      
      allow create: if isSignedIn() 
        && request.auth.uid == userId 
        && isValidId(projectId)
        && isValidProject(incoming());

      allow update: if isSignedIn() 
        && request.auth.uid == userId 
        && isValidId(projectId)
        && incoming().userId == existing().userId
        && isValidProject(incoming());

      allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(projectId);
    }

    match /users/{userId}/stories/{storyId} {
      allow get, list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && isValidId(storyId)
        && isValidStory(incoming());

      allow update: if isSignedIn()
        && request.auth.uid == userId
        && isValidId(storyId)
        && incoming().userId == existing().userId
        && isValidStory(incoming());

      allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(storyId);
    }
  }
}
